#armstrong number
import math
number=int(input("Enter number : "))
digits=int(math.log(number,10))+1
digits
def armst_num(number):
    num=0
    number2=number
    while(number2>0):
        num+=(number2%10)**digits
        number2//=10
    if(num==number):
        print(f"{number} is an armstrong number")
    else:
        print(f"{number} is not a armstrong number")
armst_num(number)



#all divisiors
number=int(input("Enter Number : "))
def all_divisiors(number):
    divisiors=[]
    for i in range(1,number):
        if(number/i==0):
            divisiors+=i
    return divisiors
all_divisiors(number)
        

        



