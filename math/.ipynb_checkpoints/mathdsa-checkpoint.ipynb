   "source": [
    "#digit concept\n",
    "a=8919\n",
    "#use %10 to get last digit\n",
    "a%10"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4fe3ffd2-b5c6-4b6b-b119-803e9dea6576",
   "metadata": {},
   "outputs": [],
   "source": [
    "#use //10 or int(/10) to remove last digit\n",
    "a//10"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02c5d63a-105f-4d8e-ad03-311ce99977e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "int(a/10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ea4a6f3b-1449-47f6-bc17-a0cf83bc892d",
   "metadata": {},
   "outputs": [],
   "source": [
    "number=a\n",
    "while(number>0):\n",
    "    lastdigit=number%10\n",
    "    number=a//10\n",
    "    print(lastdigit)"
   ]
  },
